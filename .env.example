# Credenciais AWS para o envio do código de verificação de login via
# Amazon SES (região eu-west-1, remetente fixo "Caetano <info@caetano.pt>"
# — tem de estar verificado no SES). Copia este ficheiro para ".env" e
# preenche com os dados reais. Enquanto não estiverem definidas, o código
# de acesso aparece directamente no ecrã de login (modo de teste).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
